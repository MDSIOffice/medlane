{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medlane",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/login/*", "/dashboard/*", "/api/*", "/auth/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "medlane-documents"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_STATE_KEY": "production",
    "R2_BUCKET_NAME": "medlane-documents",
    "MAX_R2_BYTES": "536870912000",
    "MAX_UPLOAD_BYTES": "26214400",
    "DOWNLOAD_CACHE_SECONDS": "300"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "medlane-preview",
      "workers_dev": true,
      "triggers": {
        "crons": []
      },
      "r2_buckets": [
        {
          "binding": "DOCUMENTS_BUCKET",
          "bucket_name": "medlane-documents-preview"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "APP_STATE_KEY": "preview",
        "R2_BUCKET_NAME": "medlane-documents-preview",
        "MAX_R2_BYTES": "536870912000",
        "MAX_UPLOAD_BYTES": "10485760",
        "DOWNLOAD_CACHE_SECONDS": "60"
      }
    },
    "production": {
      "name": "medlane",
      "workers_dev": true,
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "DOCUMENTS_BUCKET",
          "bucket_name": "medlane-documents"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_STATE_KEY": "production",
        "R2_BUCKET_NAME": "medlane-documents",
        "MAX_R2_BYTES": "536870912000",
        "MAX_UPLOAD_BYTES": "26214400",
        "DOWNLOAD_CACHE_SECONDS": "300"
      }
    }
  }
}
