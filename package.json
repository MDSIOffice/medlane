{
  "name": "medlane",
  "private": true,
  "scripts": {
    "build:css": "cleancss -o public/styles.css src/styles.css",
    "build": "npm run build:css",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "check:semantic": "bash tools/semantic-diff.sh",
    "strict:progress": "bash tools/strict-progress.sh",
    "check:noimplicitany": "bash tools/noimplicitany-gate.sh",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:any": "node tools/any-ratchet.mjs",
    "test:smoke": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@playwright/test": "^1.65.0",
    "clean-css-cli": "^5.6.3",
    "typescript": "^7.0.2"
  }
}
